# Secrets — never commit
.env

# Transient DB write-ahead/journal files (the snapshot DB itself IS committed —
# see "Committed evidence snapshot" below)
task3_pipeline_lifecycle.db-journal
task3_pipeline_lifecycle.db-wal
task3_pipeline_lifecycle.db-shm

# Build / cache artifacts
acquired_pdfs/
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd

# Internal agent working memory — not a submission deliverable
memory/

# Runtime JSON outputs that are NOT evidence (regenerated, not referenced by docs)
null_results.json
run_log.json
db_load_report.json
acquisition_results.json
prisma_counts.json
# Note: triage_results.json is a REQUIRED Task-3 deliverable (course spec + autograder),
# committed at the submission root — see MANIFEST.md "Submission-root deliverables".
# Note: Phase 3/reference_harvest_results.json IS committed as evidence — the
# PRISMA dashboard reads it for harvest stats (pdfs_scanned, raw_reference_lines).

# Phase 5: policy gate (must be manually created, never pre-committed)
Phase 5/policy_clearance.json
# Phase 5: downloaded PDFs (binary artifacts, reproducible)
Phase 5/acquired_pdfs/

# Stray root-level duplicate of Phase 5/acquisition_report.json (the canonical
# copy is committed under Phase 5/). Ignore the root path only.
/acquisition_report.json

# ---------------------------------------------------------------------------
# Committed evidence snapshot (intentionally tracked, NOT ignored):
#   task3_pipeline_lifecycle.db        — pipeline state the verifier reads
#   Phase 2/search_results.json        — retrieval evidence (check 2)
#   Phase 5/acquisition_report.json    — Phase 5 live-run evidence
# These are committed so `verify_track2_workflow.py` reports 9/9 from a clean
# checkout. They are regenerable but are pinned here as graded evidence.
